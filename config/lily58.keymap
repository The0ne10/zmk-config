#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3     &kp N4    &kp N5                          &kp N6    &kp N7    &kp N8     &kp N9   &kp N0    &kp GRAVE
&kp TAB    &kp Q   &kp W   &kp E      &kp R     &kp T                           &kp Y     &kp U     &kp I      &kp O    &kp P     &kp BSPC
&kp CAPS   &kp A   &kp S   &kp D      &kp F     &kp G                           &kp H     &kp J     &kp K      &kp L    &kp SEMI  &kp APOS
&kp LSHFT  &kp Z   &kp X   &kp C      &kp V     &kp B     &mo 1        &mo 2    &kp N     &kp M     &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                           &kp LCTRL  &kp LALT  &kp LGUI  &kp SPACE    &kp RET  &kp RGUI  &kp RALT  &kp RCTRL
            >;
        };

        layer_1 {
            bindings = <
&kp F1     &kp F2  &kp F3  &kp F4     &kp F5    &kp F6                          &kp F7    &kp F8    &kp F9     &kp F10    &kp F11    &kp F12
&none      &none   &none   &none      &none     &none                           &none     &none     &kp UP     &kp MINUS  &kp EQUAL  &kp GRAVE
&none      &none   &none   &none      &none     &none                           &none     &kp LEFT  &kp DOWN   &kp RIGHT  &none      &none
&kp LSHFT  &none   &none   &none      &none     &none    &none        &none     &kp LBKT  &kp RBKT  &none      &none      &none      &studio_unlock
                           &kp LCTRL  &kp LALT  &kp LGUI  &kp SPACE    &kp RET   &kp RGUI  &kp RALT   &kp RCTRL
            >;
        };

        layer_2 {
            bindings = <
&none  &none  &none  &none  &none  &none                    &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none                    &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none                    &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none    &none    &none  &none  &none  &none  &none  &none
                        &none  &none  &none  &none    &none  &none  &none  &none
            >;
        };
    };
};
