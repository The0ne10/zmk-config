#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3     &kp N4    &kp N5                          &kp N6    &kp N7    &kp N8     &kp N9   &kp N0    &kp GRAVE
&kp TAB    &kp Q   &kp W   &kp E      &kp R     &kp T                           &kp Y     &kp U     &kp I      &kp O    &kp P     &kp BSPC
&kp CAPS   &kp A   &kp S   &kp D      &kp F     &kp G                           &kp H     &kp J     &kp K      &kp L    &kp SEMI  &kp APOS
&kp LSHFT  &kp Z   &kp X   &kp C      &kp V     &kp B     &mo 1        &mo 2    &kp N     &kp M     &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                           &kp LCTRL  &kp LALT  &kp LGUI  &kp SPACE    &kp RET  &kp RGUI  &kp RALT  &kp RCTRL
            >;
        };

        layer_1 {
            // F-keys, navigation and symbols. Transparent positions keep base keys.
            bindings = <
&kp F1     &kp F2   &kp F3   &kp F4     &kp F5    &kp F6                          &kp F7    &kp F8    &kp F9     &kp F10    &kp F11    &kp F12
&kp TAB    &trans   &trans   &trans     &trans    &trans                         &kp PG_UP &kp PG_DN &kp UP     &kp MINUS  &kp EQUAL  &kp BSPC
&kp CAPS   &trans   &trans   &trans     &trans    &trans                         &kp HOME  &kp LEFT  &kp DOWN   &kp RIGHT  &kp END    &kp DEL
&kp LSHFT  &trans   &trans   &trans     &trans    &trans    &trans      &trans   &kp LBKT  &kp RBKT  &kp BSLH   &trans     &trans     &kp RSHFT
                             &kp LCTRL  &kp LALT  &kp LGUI  &kp SPACE    &kp RET  &kp RGUI  &kp RALT  &kp RCTRL
            >;
        };

        layer_2 {
            // macOS controls: brightness, Mission Control, Spotlight, dictation,
            // Focus, previous track, play/pause, next track, mute and volume.
            // Assign F17 to Dictation and F18 to Do Not Disturb in macOS settings.
            // Studio unlock is at base .; BT_CLR at base / clears the selected profile.
            bindings = <
&kp C_BRI_DN &kp C_BRI_UP &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS &kp C_AC_SEARCH &kp F17 &kp F18                     &kp C_PREV &kp C_PP &kp C_NEXT &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP
&kp TAB     &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4                                     &trans     &trans   &trans     &trans     &trans       &kp BSPC
&kp CAPS    &out OUT_USB &out OUT_BLE &trans       &trans       &trans                                           &trans     &trans   &trans     &trans     &trans       &trans
&kp LSHFT   &trans      &trans       &trans       &trans       &trans       &trans    &trans                   &trans     &trans   &trans     &studio_unlock &bt BT_CLR &kp RSHFT
                                        &kp LCTRL &kp LALT &kp LGUI &kp SPACE    &kp RET &kp RGUI &kp RALT &kp RCTRL
            >;
        };
    };
};

